rules_version = '2';

// Reglas de seguridad de Firestore para "Mi Baradero".
//
// IMPORTANTE: esto NO se aplica solo (copiar el archivo al repo no alcanza).
// Hay que pegarlo en Firebase Console → Firestore Database → Reglas → Publicar,
// o desplegarlo con `firebase deploy --only firestore:rules` si tenés el
// proyecto vinculado con firebase-tools.
//
// Sin esto, la separación por sectores del panel de trabajadores es solo
// una restricción visual (de la interfaz): cualquiera con las credenciales
// de un trabajador podría, en teoría, escribir en Firestore directamente
// sin pasar por la UI. Estas reglas son las que hacen cumplir el permiso
// del lado del servidor.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function trabajador() {
      return get(/databases/$(database)/documents/trabajadores/$(request.auth.uid)).data;
    }

    // Si "activo" no está (cuentas de antes de que existiera este campo)
    // se considera activa por defecto — solo queda desactivada si un
    // admin la puso explícitamente en false. OJO: hay que leerlo con
    // .get(campo, default) — acceder con ".activo" directo a un campo
    // que no existe en el documento no da "vacío", tira error, y ese
    // error termina tratando a la cuenta como si no cumpliera la regla
    // (o sea, como inactiva). Así es como se rompió el acceso de admin
    // apenas se desplegó esto la primera vez.
    function estaActivo() {
      return trabajador().get('activo', true) != false;
    }

    function esAdmin() {
      return estaLogueado() && estaActivo() && trabajador().rol == 'admin';
    }

    function esDelSector(seccion) {
      return estaLogueado() && estaActivo() && trabajador().rol == 'sector' && trabajador().sector == seccion;
    }

    function puedeEditar(seccion) {
      return esAdmin() || esDelSector(seccion);
    }

    // Dueño de un documento: cada visitante tiene un uid propio (sesión
    // anónima de Firebase Auth si no inició sesión con Google/email), y
    // los perfiles, pases, pasajes y reclamos guardan ese uid en el campo
    // "uid" al crearse.
    function esDueno() {
      return estaLogueado() && resource.data.get('uid', null) == request.auth.uid;
    }

    // Documentos de antes de que existiera "uid" (se crearon solo con el
    // id aleatorio del dispositivo): su dueño los "reclama" la primera vez
    // que los abre, escribiendo SOLO su uid. Funciona una única vez — apenas
    // tiene dueño, nadie más puede reclamarlo.
    function reclamaSinDueno() {
      return estaLogueado()
             && resource.data.get('uid', null) == null
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
             && request.resource.data.uid == request.auth.uid;
    }

    // Choferes: sector aparte de "combi" — puede escanear pasajes al
    // embarcar (viajes/embarques/marcar un pasaje como usado), pero NO
    // puede tocar horarios, alertas, aprobar pagos ni revisar
    // certificados de categoría (eso sigue siendo solo de "combi"/admin).
    function esChofer() {
      return esAdmin() || esDelSector('choferes');
    }

    // trabajadores/{uid}: cada uno lee su propio doc (para saber su rol);
    // el admin puede leer todos. Solo el admin puede crear/editar cuentas.
    match /trabajadores/{uid} {
      allow read: if estaLogueado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Contenido editable desde el panel: lectura pública (lo consume el
    // sitio para todos los vecinos), escritura solo del sector dueño o admin.
    match /eventos/{doc}          { allow read: if true; allow write: if puedeEditar('eventos'); }
    match /horariosCombi/{doc}    { allow read: if true; allow write: if puedeEditar('combi'); }
    match /alertasCombi/{doc}     { allow read: if true; allow write: if puedeEditar('combi'); }
    match /zonasResiduos/{doc}    { allow read: if true; allow write: if puedeEditar('residuos'); }
    match /consejosResiduos/{doc} { allow read: if true; allow write: if puedeEditar('residuos'); }
    match /puntosVerdesExtra/{doc}{ allow read: if true; allow write: if puedeEditar('puntosVerdes'); }

    // Documentos de estado/avisos puntuales.
    match /config/avisoEventos       { allow read: if true; allow write: if puedeEditar('eventos'); }
    match /config/avisoResiduos      { allow read: if true; allow write: if puedeEditar('residuos'); }
    match /config/estadoCamion       { allow read: if true; allow write: if puedeEditar('residuos'); }
    match /config/calendarioResiduos { allow read: if true; allow write: if puedeEditar('residuos'); }
    match /config/combiEnVivo        { allow read: if true; allow write: if puedeEditar('combi'); }

    // Perfiles de vecinos: el id del documento es el uid de la sesión
    // (anónima o de la cuenta de Google/email). Solo esa misma sesión
    // puede crearlo, editarlo o borrarlo, y SOLO con nombre/apellido/
    // notif/avatar — nunca telefono, direccion, email ni zona, que quedan
    // exclusivamente en el localStorage de cada vecino.
    //
    // Leer la lista completa es solo para el administrador; cada vecino
    // puede leer únicamente su propio documento (para recuperar su perfil
    // desde otro dispositivo si inició sesión).
    match /vecinos/{doc} {
      allow create, update: if estaLogueado() && request.auth.uid == doc
                             && request.resource.data.keys().hasOnly(['nombre', 'apellido', 'notif', 'avatar', 'creadoEn', 'actualizadoEn']);
      allow delete: if estaLogueado() && request.auth.uid == doc;
      allow read: if esAdmin() || (estaLogueado() && request.auth.uid == doc);
    }

    // Historial de actividad: cualquier trabajador logueado y activo puede
    // agregar una entrada (login/logout/acciones), pero es de solo lectura
    // para el admin, e inmutable para todos (no se edita ni se borra).
    // Reclamos: quejas, reclamos, sugerencias y felicitaciones que manda
    // cualquier vecino desde /reclamos, sin login. Siempre nacen en
    // estado "nuevo" y solo con los campos del formulario — el vecino no
    // puede escribirse una respuesta ni marcarse el reclamo como resuelto.
    //
    // Un reclamo tiene nombre, ubicación y foto del vecino: "get" es solo
    // de quien lo creó (campo uid) o del sector que lo atiende. "list" —
    // recorrer todos los reclamos — es solo del sector/admin. Cambiar
    // estado, responder o eliminar también es solo de ellos.
    //
    // Los tamaños tienen tope para que nadie pueda llenar la base con
    // textos o fotos gigantes (la foto va como data URL comprimida).
    //
    // Cada reclamo tiene un "departamento" (según el tema que eligió el
    // vecino, o al que lo derivó un empleado). Un sector del panel ve y
    // atiende solo los de sus departamentos; Atención al Vecino (sector
    // "reclamos") y el admin, todos. Este mapa tiene que coincidir con
    // DEPARTAMENTOS en src/data/reclamosData.js.
    function departamentoValido(depto) {
      return depto in ['atencionVecino', 'transporte', 'higieneUrbana', 'ambiente', 'cultura',
                       'obrasPublicas', 'alumbrado', 'espaciosVerdes', 'sistemas'];
    }
    function deptosDelSector(sector) {
      return {
        'combi': ['transporte'],
        'residuos': ['higieneUrbana'],
        'puntosVerdes': ['ambiente'],
        'eventos': ['cultura']
      }.get(sector, []);
    }
    function atiendeReclamo(depto) {
      return puedeEditar('reclamos')
             || (estaLogueado() && estaActivo() && trabajador().rol == 'sector'
                 && depto in deptosDelSector(trabajador().sector));
    }

    function textoCorto(campo, maximo) {
      return request.resource.data.get(campo, '') is string
             && request.resource.data.get(campo, '').size() <= maximo;
    }

    match /reclamos/{id} {
      allow get: if resource == null || esDueno() || atiendeReclamo(resource.data.departamento);
      allow list: if atiendeReclamo(resource.data.departamento);
      allow create: if estaLogueado()
                     && request.resource.data.keys()
                       .hasOnly(['uid', 'tipo', 'area', 'departamento', 'mensaje', 'ubicacion', 'nombre', 'fotoUrl', 'estado', 'creadoEn', 'actualizadoEn'])
                     && request.resource.data.uid == request.auth.uid
                     && departamentoValido(request.resource.data.departamento)
                     && request.resource.data.estado == 'nuevo'
                     && request.resource.data.tipo in ['queja', 'reclamo', 'sugerencia', 'felicitacion']
                     && request.resource.data.mensaje is string
                     && request.resource.data.mensaje.size() >= 10
                     && request.resource.data.mensaje.size() <= 1000
                     && textoCorto('area', 40)
                     && textoCorto('nombre', 80)
                     && textoCorto('ubicacion', 200)
                     && textoCorto('fotoUrl', 700000);
      // Un sector puede cambiar estado, responder y derivar a otro
      // departamento los reclamos que le llegan — nada más (no puede
      // reescribir el mensaje, el nombre ni la foto del vecino).
      // Eliminar es solo de Atención al Vecino / admin.
      allow update: if (atiendeReclamo(resource.data.departamento)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['estado', 'respuesta', 'departamento', 'actualizadoEn', 'respondidoPor', 'respondidoEn'])
                        && departamentoValido(request.resource.data.departamento)
                        && request.resource.data.estado in ['nuevo', 'en_proceso', 'resuelto']
                        && textoCorto('respuesta', 2000))
                    || reclamaSinDueno();
      allow delete: if puedeEditar('reclamos');
    }

    match /historial/{doc} {
      allow create: if estaLogueado() && estaActivo();
      allow read: if esAdmin();
      allow update, delete: if false;
    }

    // Pasajeros: categoría verificada (estudiante/jubilado/discapacidad)
    // y pase QR de la combi. El "id" del documento es el id aleatorio del
    // dispositivo, y el campo "uid" dice de quién es. Como incluye la foto
    // del DNI/CUD, leerlo es solo del dueño o del sector combi/admin, y
    // "list" (recorrer todo el padrón) solo de combi/admin.
    function esAutoServicioPasajero() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      // El chequeo de estadoVerificacion solo aplica SI ese campo es uno
      // de los que está cambiando — si no se toca (ej: solo se rota el
      // token del QR), no importa qué valor tenga hoy (podría estar
      // "aprobada", que es exactamente el caso más común al renovar el
      // pase).
      return cambios.hasOnly(['nombre', 'categoriaSolicitada', 'documentoUrl', 'token', 'tokenGeneradoEn', 'estadoVerificacion', 'actualizadoEn'])
             && (!cambios.hasAny(['estadoVerificacion']) || request.resource.data.estadoVerificacion in ['sin_solicitud', 'pendiente']);
    }

    match /pasajeros/{id} {
      allow get: if resource == null || esDueno() || puedeEditar('combi');
      allow list: if puedeEditar('combi');
      allow create: if estaLogueado()
                     && request.resource.data.keys()
                       .hasOnly(['uid', 'nombre', 'categoriaSolicitada', 'documentoUrl', 'token', 'tokenGeneradoEn', 'estadoVerificacion', 'creadoEn', 'actualizadoEn'])
                     && request.resource.data.uid == request.auth.uid
                     && request.resource.data.estadoVerificacion in ['sin_solicitud', 'pendiente'];
      // El propio pasajero solo puede mandar una solicitud nueva o rotar
      // el token de su QR — nunca puede aprobarse o rechazarse a sí
      // mismo. Aprobar/rechazar (tocar estadoVerificacion a esos valores,
      // o motivoRechazo) es solo del empleado del sector combi/admin.
      allow update: if puedeEditar('combi') || (esDueno() && esAutoServicioPasajero()) || reclamaSinDueno();
    }

    // Viajes: instancia de un horario de combi para un día puntual
    // (id = "{horarioId}_{fecha}"), con el cupo de asientos y los
    // contadores de embarque de ESE día. Lectura pública para que
    // cualquiera vea cuántos lugares quedan antes de salir de casa;
    // escritura de combi/admin (arma los horarios) o de un chofer (lo
    // crea/actualiza al escanear un pasaje).
    match /viajes/{id} {
      allow read: if true;
      allow write: if puedeEditar('combi') || esChofer();

      // Embarques confirmados de ese viaje: un documento por pasajero
      // (id = pasajeroId) garantiza que el mismo pase nunca cuenta dos
      // veces en el mismo viaje. Es un registro, no se edita ni se borra.
      match /embarques/{pasajeroId} {
        allow read: if puedeEditar('combi') || esChofer();
        allow create: if puedeEditar('combi') || esChofer();
        allow update, delete: if false;
      }
    }

    // Pasajes: un ticket puntual para un viaje específico (no un abono
    // general) — id = "{pasajeroId}_{horarioId}_{fecha}", así nadie
    // termina con dos pasajes pendientes para el mismo viaje. Nace
    // "pendiente" (sin QR), un empleado confirma el pago y ahí pasa a
    // "confirmado" (con QR); el conductor lo marca "usado" al embarcar.
    //
    // Igual que con pasajeros: el propio pasajero solo puede tocar su
    // pasaje mientras sigue "pendiente" y sin usar (antes de que un
    // empleado lo confirme) — después queda congelado para él.
    function categoriaEstaAprobada(pasajeroId, categoria) {
      let p = get(/databases/$(database)/documents/pasajeros/$(pasajeroId)).data;
      return p.get('uid', null) == request.auth.uid
             && p.estadoVerificacion == 'aprobada' && p.categoriaSolicitada == categoria;
    }
    // "comun" nunca necesita leer pasajeros/{pasajeroId} (puede no
    // existir todavía si alguien compra sin haber verificado nunca una
    // categoría) — por eso ese caso va primero y corta antes del get().
    function categoriaValidaParaComprar(pasajeroId, categoria) {
      return categoria == 'comun' || categoriaEstaAprobada(pasajeroId, categoria);
    }
    // Tarifas: tienen que coincidir con TARIFAS_RUTA y calcularImporte()
    // en src/utils/pase.js. Mismo precio en los dos sentidos; una ruta
    // desconocida cobra la tarifa más alta (nunca de menos).
    function tarifaRuta(origen, destino) {
      let tarifas = {'Alsina|Baradero': 2000, 'Baradero|Portela': 2600};
      return tarifas.get(origen < destino ? origen + '|' + destino : destino + '|' + origen, 2600);
    }
    function importeEsperado(categoria, origen, destino) {
      return categoria == 'discapacidad' ? 0
           : categoria in ['estudiante', 'jubilado'] ? tarifaRuta(origen, destino) / 2
           : tarifaRuta(origen, destino);
    }
    // Un pasaje por persona, horario y fecha: el id lo fija
    // (pasajeroId_horarioId_fecha), y el importe tiene que ser la tarifa.
    function datosPasajeValidos(id) {
      let d = request.resource.data;
      return estaLogueado()
             && d.uid == request.auth.uid
             && id == d.pasajeroId + '_' + d.horarioId + '_' + d.fecha
             && d.categoria in ['comun', 'estudiante', 'jubilado', 'discapacidad']
             && d.origen is string && d.destino is string
             && d.importe == importeEsperado(d.categoria, d.origen, d.destino)
             && d.keys().hasOnly([
               'uid', 'pasajeroId', 'nombre', 'categoria', 'horarioId', 'fecha',
               'salida', 'origen', 'destino', 'importe', 'estado', 'usado', 'creadoEn', 'actualizadoEn',
               'formaPago', 'vencePagoEn'
             ])
             && request.resource.data.estado == 'pendiente'
             && request.resource.data.usado == false
             && categoriaValidaParaComprar(request.resource.data.pasajeroId, request.resource.data.categoria);
    }

    match /pasajes/{id} {
      allow get: if resource == null || esDueno() || puedeEditar('combi') || esChofer();
      // "list" con filtros (ej: buscar por código para un horario) lo
      // necesita tanto ventas (revisar pendientes de pago) como un
      // chofer (buscar el pasaje que le dictaron).
      allow list: if puedeEditar('combi') || esChofer();
      allow create: if datosPasajeValidos(id);
      // El chofer solo puede marcar un pasaje como "usado" al embarcar
      // (eso lo hace la transacción de embarque) — nunca puede
      // confirmar un pago ni tocar cualquier otro campo.
      allow update: if puedeEditar('combi')
                    || (esChofer() && resource.data.estado == 'confirmado'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['usado', 'usadoEn', 'conductorUid', 'conductorEmail'])
                        && request.resource.data.usado == true)
                    || (esDueno() && resource.data.estado == 'pendiente' && resource.data.usado == false && datosPasajeValidos(id))
                    || reclamaSinDueno();
    }
  }
}
